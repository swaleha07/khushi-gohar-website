# ==============================================================================
# Khushi & Gohar - Mobile OTP Authentication & SMS Provider Configuration
# ==============================================================================

# Choose SMS Provider: 'fast2sms' | 'twilio' | 'msg91'
# If left unset or set to empty, the backend will return a 502 error asking you to configure a live provider.
# DO NOT leave this empty in production if you want live SMS delivery to Indian mobile numbers.
SMS_PROVIDER=fast2sms

# ------------------------------------------------------------------------------
# 1. Fast2SMS Configuration (Recommended & fastest for India / +91 numbers)
# Sign up at: https://www.fast2sms.com/
# Copy API Key from: Dev API -> Authorization Key
# ------------------------------------------------------------------------------
FAST2SMS_API_KEY=your_fast2sms_api_key_here
# Optional generic alias:
# SMS_PROVIDER_API_KEY=your_fast2sms_api_key_here

# ------------------------------------------------------------------------------
# 2. Twilio SMS Configuration (Global SMS delivery)
# https://www.twilio.com/
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
# Optional generic aliases:
# SMS_PROVIDER_AUTH_TOKEN=your_twilio_auth_token_here
# SMS_PROVIDER_SENDER_ID=+1234567890

# ------------------------------------------------------------------------------
# 3. MSG91 Configuration (DLT registered SMS in India)
# https://msg91.com/
# ------------------------------------------------------------------------------
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_dlt_template_id_here
# MSG91_SENDER_ID=KHUSHI

# ------------------------------------------------------------------------------
# 4. Security & Sessions
# Secret key used to sign HMAC session & OTP challenge tokens (min 32 characters in production)
# ------------------------------------------------------------------------------
SESSION_SECRET=khushi_luxury_skincare_production_secret_key_change_me_2026

# ------------------------------------------------------------------------------
# 5. Secure Admin Authentication
# IMPORTANT: Change these credentials before deploying to production!
# Never expose these credentials in client-side code.
# ------------------------------------------------------------------------------
ADMIN_USERNAME=khushi_admin
ADMIN_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
ADMIN_SESSION_SECRET=khushi_admin_super_secret_signing_key_change_in_production_2026

# ------------------------------------------------------------------------------
# 6. Payment Gateway & UPI QR Configuration
# ------------------------------------------------------------------------------
# Mode: 'simulation' (Sandbox developer mode) | 'production' (Real Razorpay)
PAYMENT_MODE=simulation
NEXT_PUBLIC_PAYMENT_MODE=simulation

# Merchant Details displayed in Payment Modals & UPI payload
MERCHANT_NAME="Parveen Bano"
MERCHANT_UPI_ID="parveenbanowith-1@okhdfcbank"
NEXT_PUBLIC_MERCHANT_NAME="Parveen Bano"
NEXT_PUBLIC_MERCHANT_UPI_ID="parveenbanowith-1@okhdfcbank"

# Razorpay Credentials (required for production payment capture & verification)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

